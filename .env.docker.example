# Copy to .env.docker (git-ignored). Used by the Sage container.
# DB_HOST/DB_PORT are set to the "db" service by docker-compose.yml.
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-key
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT_MINI=your-deployment
AZURE_OPENAI_DEPLOYMENT_LARGE=
DB_USER=sage_reader
DB_PASSWORD=change-me-reader
DB_REQUIRE_TLS=false
DB_SSL_CA=
SMTP_USERNAME=
SMTP_APP_PASSWORD=
OWNER_PASSWORD=
APP_DEBUG=false
DEMO_MODE=false
EXCEL_DATA_DIR=
