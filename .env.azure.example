# Copy to .env.azure (git-ignored). Used by deploy-azure-aca.sh; each value becomes a Container App secret.
# The Azure app needs a MySQL server reachable from Azure (e.g. Azure Database for MySQL).
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_KEY=your-key
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_DEPLOYMENT_MINI=your-deployment
DB_HOST=your-server.mysql.database.azure.com
DB_PORT=3306
DB_USER=sage_reader
DB_PASSWORD=change-me
DB_REQUIRE_TLS=true
OWNER_PASSWORD=
APP_DEBUG=false
DEMO_MODE=false
